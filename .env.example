# ---- LLM (pick ONE block) -------------------------------------------------
# Anthropic Claude
LLM_PROVIDER=anthropic
# claude-haiku-5-5 = lowest cost; claude-sonnet-5-5 = stronger reasoning
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint (free options: Groq, local Ollama)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_...
# Ollama (local, free): LLM_BASE_URL=http://localhost:11434/v1 and a tool-capable model, e.g. LLM_MODEL=qwen2.5:7b

# ---- Services --------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuition
GATEWAY_URL=http://127.0.0.1:8000
TUITION_API_URL=http://127.0.0.1:8001
# Remove MCP_SERVER_URL to let the agent spawn the MCP server itself over stdio
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
